# Files/folders that must NOT be uploaded as public static assets.
# This file uses the same format as .gitignore.
#
# The key entry is "node_modules/": the build installs dependencies
# (e.g. sass, wrangler) into this folder, and it contains binaries such as
# node_modules/workerd/bin/workerd (~129 MiB) that exceed Cloudflare's
# 25 MiB per-asset limit and would fail the deploy.

# Dependencies & tooling (installed at build time; never serve these)
node_modules/
.git/
.vscode/

# Project config / metadata (not meant to be served to visitors)
wrangler.jsonc
wrangler.toml
wrangler.json
package.json
package-lock.json
README.md
.gitignore
.gitattributes
